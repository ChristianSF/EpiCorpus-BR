{"relatorio": "boletim_eletronico_ano08_n17", "pagina": 2, "sentenca_id": "boletim_eletronico_ano08_n17_s0028", "texto": "Para a investigação laboratorial foi coletado líquido cefalorraquidiano (LCR) e sangue dos pacientes suspeitos.", "tokens": ["Para", "a", "investigação", "laboratorial", "foi", "coletado", "líquido", "cefalorraquidiano", "(LCR)", "e", "sangue", "dos", "pacientes", "suspeitos."], "bio_tags": ["O", "O", "O", "O", "O", "O", "O", "O", "O", "O", "O", "O", "O", "O"], "spans": []}
